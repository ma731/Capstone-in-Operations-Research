# Environment & secrets
.env
*.lic
gurobi.lic

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual envs
.venv/
venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.cache
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Data — raw never committed; processed only if small
data/raw/
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# OS
Thumbs.db

# Outputs
*.log
results/
tmp/
# Publication figures are tracked so the TeX sources build from a clean clone.
# Generated scratch figures should use `results/`; figures used by publications
# are intentionally versioned in this directory.
!figures/.gitkeep

# LaTeX build artifacts
thesis/*.aux
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.bbl
thesis/*.blg

# full_thesis build artifacts + scratch/preview files
full_thesis/*.aux
full_thesis/*.log
full_thesis/*.out
full_thesis/*.toc
thesis/_*.png
thesis/_*.txt
full_thesis/_*.txt
thesis/*.bak
*.ORIG.bak
poster/_*.png

# deck build artifacts
deck/_preview/
deck/_eq_*.png
deck/_sheet.png

# Archived Iberia material contains raw Electricity Maps data (non-redistributable)
archive_iberia_removed/
poster/node_modules/
*.fdb_latexmk
*.fls
docs/results_snapshots/*.out

# Old poster iterations: only v24 (build_v24.js -> poster_capstone_v24.*) is canonical
# and tracked; the broad patterns below ignore superseded scratch output. Canonical files
# remain tracked because they were force-added when v24 was published.
poster/build_v*.js
poster/poster_capstone.pdf
poster/poster_capstone.pptx
poster/poster_capstone_FINAL.*
poster/poster_capstone_v*.pdf
poster/poster_capstone_v*.pptx
!poster/build_v24.js
!poster/poster_capstone_v24.pdf
!poster/poster_capstone_v24.pptx
poster/poster_capstone_v*_CMYK_print.pdf
poster/poster_v*_PREVIEW.png
poster/poster_v*_proof.pdf
poster/poster_v*_A4_proof.pdf
poster/toplook.png

# Transient LaTeX recompile log
thesis/_recompile.log

# Office/editor lock + scratch files (LibreOffice drops these next to the poster PDFs)
.~lock.*
poster/*.tmp
